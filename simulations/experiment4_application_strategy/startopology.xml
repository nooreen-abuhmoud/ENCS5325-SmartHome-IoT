<config>

    <!-- Smart Home wireless network -->
    <interface hosts="controller"
               names="wlan0"
               address="10.0.0.1"
               netmask="255.255.255.0"/>

    <interface hosts="sensor* lamp*"
               names="wlan0"
               address="10.0.0.x"
               netmask="255.255.255.0"/>

    <!-- Gateway to core network -->
    <interface hosts="controller"
               names="ppp0"
               address="192.168.0.1"
               netmask="255.255.255.252"/>

    <interface hosts="monitoringServer"
               names="ppp0"
               address="192.168.0.2"
               netmask="255.255.255.252"/>

    <!-- Smart-home devices use gateway -->
    <route hosts="sensor* lamp*"
           destination="*"
           gateway="10.0.0.1"/>

    <!-- Gateway routes -->
    <route hosts="controller"
           destination="10.0.0.0"
           netmask="255.255.255.0"
           interface="wlan0"/>

    <route hosts="controller"
           destination="192.168.0.0"
           netmask="255.255.255.252"
           interface="ppp0"/>

    <!-- Server return route -->
    <route hosts="monitoringServer"
           destination="10.0.0.0"
           netmask="255.255.255.0"
           gateway="192.168.0.1"/>

</config>